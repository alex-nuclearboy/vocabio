# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

# Generate a separate secret key for the local environment:
#
# poetry run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Paste the generated value after the equals sign.
DJANGO_SECRET_KEY=

# Enable debug mode only for local development.
# Never enable it in production.
DJANGO_DEBUG=True

# Comma-separated hostnames or IP addresses.
# Do not include schemes, paths, or trailing slashes.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]


# ---------------------------------------------------------------------------
# Local PostgreSQL
# ---------------------------------------------------------------------------

# These values configure the PostgreSQL container started by Docker Compose.
POSTGRES_DB=vocabio
POSTGRES_USER=vocabio

# Create a local database password and paste it after the equals sign.
# Use URL-safe characters because it is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=

# Django connects through the port published by Docker Compose.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432


# ---------------------------------------------------------------------------
# Database connection
# ---------------------------------------------------------------------------

# Build the local database URL from the PostgreSQL values above.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Close database connections after each request during local development.
DATABASE_CONN_MAX_AGE=0

# Connection health checks can remain disabled for local development.
DATABASE_CONN_HEALTH_CHECKS=False

# Maximum time, in seconds, allowed to establish a database connection.
DATABASE_CONNECT_TIMEOUT=5


# ---------------------------------------------------------------------------
# Application locale and time zone
# ---------------------------------------------------------------------------

# Language code used by Django for the local environment.
DJANGO_LANGUAGE_CODE=en-gb

# IANA time zone used by Django for the local environment.
DJANGO_TIME_ZONE=UTC
